  "siteContent": {
    "home": {
      "title": "Jornadas de Actualización en Atención Primaria (JAP)",
      "subtitle": "Programa docente 2026-2027",
      "description": "Programa docente anual de sesiones clínicas prácticas, centradas en problemas frecuentes de Atención Primaria y orientadas a decisiones de consulta.",
      "primary_button": "Ver agenda",
      "secondary_button_sessions": "Sesiones",
      "secondary_button_speakers": "Equipo docente",
      "secondary_button_resources": "Recursos",
      "metrics": {
